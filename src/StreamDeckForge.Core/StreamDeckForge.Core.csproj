<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- UseWPF donne acces a System.Drawing/Imaging (icones) et aux assemblies
         UIAutomationClient / UIAutomationTypes livrees avec Microsoft.WindowsDesktop.App. -->
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le SDK WindowsDesktop n'inclut pas System.IO dans ses usings implicites. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fiches du catalogue embarque : elles doivent voyager dans l'assembly, la
         publication en fichier unique ne laissant aucun dossier a cote de l'exe.
         WithCulture=false est indispensable : sans lui, MSBuild prend un nom comme
         "excel.fr.json" pour une ressource localisee et la deporte dans un assembly
         satellite, ou le chargeur ne la trouve plus. Les fiches sont donc nommees
         "excel-fr.json", et la langue est declaree dans le JSON lui-meme. -->
    <EmbeddedResource Include="Catalog\*.json" WithCulture="false" />
  </ItemGroup>

</Project>
