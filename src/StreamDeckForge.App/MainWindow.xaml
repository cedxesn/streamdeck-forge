<Window x:Class="StreamDeckForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamDeckForge - generateur de profils Stream Deck"
        Height="780" Width="1240"
        MinHeight="620" MinWidth="1060"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tete -->
        <StackPanel Grid.Row="0" Margin="4,0,4,14">
            <TextBlock Text="StreamDeckForge" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource SubtleTextStyle}"
                       Text="Detecte les applications installees, extrait leurs raccourcis clavier et genere un profil .streamDeckProfile pret a importer." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!-- 1. Applications -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleTextStyle}"
                               Text="1. Application" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <Button Grid.Column="1" Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Rescanner"
                                Command="{Binding ScanCommand}" />
                    </Grid>

                    <Button DockPanel.Dock="Top" Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Ajouter un executable (.exe)..."
                            Command="{Binding AddExecutableCommand}" />

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SubtleTextStyle}"
                               Margin="0,8,0,0"
                               Text="Recherche par nom, editeur ou chemin. 400 resultats au maximum." />

                    <ListBox ItemsSource="{Binding Applications}"
                             SelectedItem="{Binding SelectedApplication}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="24" Height="24"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Source="{Binding Icon}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                                   Text="{Binding PathLabel}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 2. Extraction -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleTextStyle}"
                               Text="2. Extraction des raccourcis" />

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding UseAcceleratorTables}"
                                  Content="Methode 1 - tables d'accelerateurs Win32 (lecture du binaire)" />
                        <CheckBox IsChecked="{Binding UseUiAutomation}"
                                  Content="Methode 2 - UI Automation (application demarree requise)" />
                        <CheckBox IsChecked="{Binding UseConfigFiles}"
                                  Content="Methode 3 - fichiers de configuration locaux" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox IsChecked="{Binding ScanCompanionModules}"
                                      Margin="0,0,18,0"
                                      Content="Inclure les DLL voisines" />
                            <CheckBox IsChecked="{Binding ExpandMenus}"
                                      Content="Deplier les menus" />
                        </StackPanel>
                    </StackPanel>

                    <Button DockPanel.Dock="Top"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,10"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Extraire les raccourcis"
                            Command="{Binding ExtractCommand}" />

                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0"
                            Background="#FFF7F7F7"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10"
                            Visibility="{Binding ExtractionReport, Converter={StaticResource EmptyToCollapsedConverter}}">
                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Text="{Binding ExtractionReport}" />
                    </Border>

                    <ListView ItemsSource="{Binding Shortcuts}"
                              SelectedItem="{Binding SelectedShortcut}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="36">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Titre de la touche" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Combinaison" Width="150"
                                                DisplayMemberBinding="{Binding Keys}" />
                                <GridViewColumn Header="Methode" Width="110"
                                                DisplayMemberBinding="{Binding MethodLabel}" />
                                <GridViewColumn Header="Provenance" Width="220"
                                                DisplayMemberBinding="{Binding Origin}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- 3. Profil -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleTextStyle}"
                               Text="3. Profil Stream Deck" />

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SubtleTextStyle}"
                                   Text="Modele" Margin="0,0,0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SubtleTextStyle}"
                                   Text="Nom du profil" Margin="8,0,0,3" />

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding Device}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                                 Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Text="Selectionnez un raccourci dans la liste puis cliquez une touche pour l'y placer. Sans selection, le clic libere la touche." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Remplissage auto"
                                        Command="{Binding AutoFillCommand}" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Content="Vider"
                                        Command="{Binding ClearGridCommand}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Exporter le profil"
                                    Command="{Binding ExportCommand}" />
                        </Grid>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SubtleTextStyle}"
                               HorizontalAlignment="Right" Margin="0,8,0,0"
                               Text="{Binding CapacityLabel}" />

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
                        <ItemsControl ItemsSource="{Binding Cells}" Width="400">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding DataContext.Device.Rows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 Columns="{Binding DataContext.Device.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource KeyButtonStyle}"
                                            Height="72"
                                            Command="{Binding DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Keys}">
                                        <StackPanel VerticalAlignment="Center" Margin="6">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="40"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Keys}"
                                                       Foreground="#FF6FB7E8"
                                                       FontSize="9.5"
                                                       Margin="0,3,0,0"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Barre d'etat -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,9"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Status}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="120" Height="4"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
